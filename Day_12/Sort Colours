class Solution {
    public void sortColors(int[] nums) {
       merge(nums,0,nums.length-1);
        
    }
    public void merge(int [] nums,int low, int high){
        if(low>= high){
            return;
        }
        int mid = low +(high-low)/2;
        merge( nums,low,mid);
        merge(nums,mid+1,high);
        merger_join(nums,mid,low,high);

    }
    public void merger_join(int[] nums,int mid,int left,int right){
        int k=0;
        int [] temp = new int[right-left+1];
        int i = left;
        int j = mid+1;
        while(i<=mid && j<=right){
            if(nums[i]<=nums[j]){
                temp[k] = nums[i];
                i++;
            }
            else{
                temp[k] = nums[j];
                j++;
            }
            k++;
        }
        while(i<=mid){
            temp[k] = nums[i];
            k++;
            i++;
        }
        while (j<= right){
            temp[k] = nums[j];
            j++;
            k++;
}
for(int p= 0 ;p<temp.length;p++){
    nums[left+p]  = temp[p]; 
}
    }
}
