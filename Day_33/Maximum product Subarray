class Solution {
    public int maxProduct(int[] nums) {
int n = nums.length;
int ans = Integer.MIN_VALUE;
int perfix = 1;
int suffix = 1;
for(int i=0;i<n;i++){
if(perfix==0){
perfix=1;
}
if(suffix==0){
suffix = 1;
}
perfix*= nums[i];
suffix *=nums[n-i-1];
ans = Math.max(ans,Math.max(perfix,suffix));
}
return ans;
}
}
