class Solution {
public long totalhr(int[] piles,int mid){
long total_hr= 0;
for(int i =0;i<piles.length;i++){
total_hr += (piles[i]+mid-1L)/mid;
}
return total_hr;
}
 public int minEatingSpeed(int[] piles, int h) {
int left =1;
int high = Arrays.stream(piles).max().getAsInt();
int ans = high;
while(left<=high){
int mid = left+(high-left)/2;
long  th = totalhr(piles,mid);
if(th<=h){
ans = mid;
high= mid-1;
}
else{
left = mid+1;
}

}
return ans ;
}
}
