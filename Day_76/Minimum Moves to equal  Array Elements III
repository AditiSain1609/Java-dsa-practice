class Solution {
    public int minMoves(int[] nums) {
        int moves = 0;
        int max = Integer.MIN_VALUE;
        int n = nums.length;
        for(int i =0;i<n;i++){
            max = Math.max(max,nums[i]);
        }
    for(int i = 0;i<n;i++){
        while(nums[i] != max){
            nums[i] ++;
            moves ++;
        }
    }
    return moves;
    }
}
