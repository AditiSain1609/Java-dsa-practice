class Solution {
    public ListNode partition(ListNode head, int x) {
        ListNode smallerDummy = new ListNode(0);
        ListNode largerDummy = new ListNode(0);
        ListNode small = smallerDummy;
        ListNode larger = largerDummy;
        ListNode temp = head;
        while(temp !=null){
            if(temp.val <x){
                small.next = temp;
                small = small.next;
            }
            else{
                larger.next = temp;
                larger = larger.next;
            }
            temp = temp.next;
        }
        larger.next = null;
        small.next = largerDummy.next;
         return smallerDummy.next;
    }
}
