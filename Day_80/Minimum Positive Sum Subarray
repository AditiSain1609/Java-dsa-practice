class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
       int minsum  = Integer.MAX_VALUE;
          int sum =0;
        int sixe = 0;
        int n = nums.size();
          for(int i =0;i<n;i++){
              for(int j = i;j<n;j++){
                 
                     
                     sum+= nums.get(j);
                     sixe = j-i+1;
                     
                 
                  if(sixe >= l && sixe <= r && sum > 0) {
                    minsum = Math.min(sum, minsum);
                  }
              }
                sum =0;
                
                 
                 sixe =0;
                 
              
          }
              
        
        if(minsum == Integer.MAX_VALUE){
            return -1;
        }
       return  minsum;

   
    }
}
