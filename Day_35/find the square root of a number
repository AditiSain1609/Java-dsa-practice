class Solution {
    public int floorSqrt(int n) {
      int ans =0;
      int left =1;
      int right = n/2;
      while(left<=right){
        long mid = left+(right-left)/2;
        if(mid*mid<=n){
            ans = (int)mid;
            left=(int)mid+1;

        }
        else{
            right = (int)mid-1;
        }
      }
      return ans;

    }
}
