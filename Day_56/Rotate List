lass Solution {
    public ListNode rotateRight(ListNode head, int k) {
         if(head==null || head.next == null || k ==0){
            return head;
         }
    int n = 1;
    ListNode temp = head;
    while(temp.next!= null){
        temp = temp.next;
        n++;
    }
     k = k %n;
     if(k ==0){
        return head;
     }
     temp.next = head;
     int step = n - k;
     ListNode newtail = head;
     for(int i = 1;i<step;i++){
        newtail = newtail.next;
     }
     ListNode newHead = newtail.next;
       newtail.next = null;
   
       return newHead;
    }
}
