class Solution {
    public void rotateMatrix(int[][] mat) {
      int n= mat.length;
      for(int i=0;i<n;i++){
          for(int j=i+1;j<n;j++){
              int temp=mat[i][j];
              mat[i][j] = mat[j][i];
              mat[j][i] = temp;
          }
      }
      for(int i=0;i<n;i++){
          int top=0;
          int buttom = n-1;
          while(top<buttom){
              int temp=mat[top][i];
              mat[top][i]= mat[buttom][i];
              mat[buttom][i]= temp;
              top++;
              buttom--;
          }
      }
        
    }
}
