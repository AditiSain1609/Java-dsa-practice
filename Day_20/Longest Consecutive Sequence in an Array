class Solution {
    public int longestConsecutive(int[] nums) {
        HashSet<Integer> set = new HashSet<>();
        if(nums.length==0){
            return 0;
        }
        for(int num:nums){
            set.add(num);
        }
        int logest =0;
        for(int el :set){
            if(!set.contains(el-1)){
                int currnum = el;
                int currlen=1;
            
            while(set.contains(currnum+1)){
               currlen ++;
                currnum++;
            }
            logest = Math.max(logest,currlen);
        }
        }

     return logest;
        
    }
}
