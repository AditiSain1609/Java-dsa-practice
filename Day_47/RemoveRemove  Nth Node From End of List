class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
      if(head==null || head.next==null){
        return null;
      }  
      int count = 0;
      ListNode temp = head;
      while(temp!=null){
        count++;
        temp = temp.next;
      }

      int point = count-n;
      temp = head;
      if (point == 0) {
            return head.next;
        }

        for (int i = 1; i < point; i++) {
            temp = temp.next;
        }


        temp.next = temp.next.next;

        return head;
    }
}
